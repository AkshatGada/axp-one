  "components": {
    "schemas": {
      "Campaign": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "campaignId"
        ],
        "properties": {
          "campaignId": {
            "type": "string"
          },
          "businessName": {
            "type": "string",
            "maxLength": 400
          },
          "creative": {
            "type": "string",
            "maxLength": 800
          },
          "contextHints": {
            "type": "string",
            "maxLength": 400
          },
          "approved": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "active",
              "paused"
            ]
          },
          "maxBidBaseUnits": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "budgetCapBaseUnits": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "declaredConstraints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "crypto_storage",
                "hardware_wallet",
                "offline_key_storage",
                "ethereum",
                "solana",
                "mobile_software_wallet",
                "physical_wallet",
                "rfid_blocking"
              ]
            }
          }
        }
      },
      "Turn": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "scenarioId"
            ],
            "properties": {
              "scenarioId": {
                "enum": [
                  "cached",
                  "offline",
                  "repeat",
                  "mobile"
                ]
              },
              "financialMode": {
                "const": "sandbox"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "financialMode",
              "turnId",
              "question",
              "mandatoryCapabilities"
            ],
            "properties": {
              "financialMode": {
                "const": "synthetic"
              },
              "turnId": {
                "type": "string",
                "pattern": "^lab-[\\w-]{1,60}$"
              },
              "question": {
                "type": "string",
                "maxLength": 1200
              },
              "mandatoryCapabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "Render": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domInserted",
          "sponsoredLabelPresent",
          "creativeHash"
        ],
        "properties": {
          "financialMode": {
            "enum": [
              "sandbox",
              "synthetic"
            ]
          },
          "domInserted": {
            "type": "boolean"
          },
          "sponsoredLabelPresent": {
            "type": "boolean"
          },
          "creativeHash": {
            "type": "string"
          }
        }
      },
      "Fail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "financialMode": {
            "enum": [
              "sandbox",
              "synthetic"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "LocalOperatorToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-axp-csrf"
      }
    }
  }
}
