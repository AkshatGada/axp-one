            "name": "question",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "campaignId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded source-linked retrieval or null in replay",
            "content": {
              "application/json": {
                "schema": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v3/campaign": {
      "post": {
        "security": [
          {
            "LocalOperatorToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Campaign"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved outcome; never automatically retry a failed or uncertain operation"
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Missing local operator token or model-enable capability"
          },
          "404": {
            "description": "Unavailable operation"
          },
          "405": {
            "description": "Replay is read-only"
          },
          "409": {
            "description": "Waiting, conflict or run-in-progress"
          }
        }
      }
    },
