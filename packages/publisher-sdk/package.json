{
  "name": "@axp/publisher-sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "Server ad requests and observed native Sponsored rendering for AXP",
  "exports": {
    ".": { "types": "./index.d.mts", "import": "./index.mjs" },
    "./browser": { "types": "./browser.d.mts", "import": "./browser.mjs" },
    "./financial": { "types": "./financial.d.mts", "import": "./financial.mjs" },
    "./receipt": { "types": "./receipt.d.mts", "import": "./receipt.mjs" },
    "./react": "./react.tsx"
  },
  "files": ["*.mjs", "*.d.mts", "react.tsx", "README.md"],
  "scripts": { "prepublishOnly": "node -e \"throw new Error('Local pilot tarball only; publication is not authorized')\"" },
  "engines": { "node": ">=22.18.0" }
}
