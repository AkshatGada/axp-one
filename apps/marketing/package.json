{
  "name": "@axp/marketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "extract": "node scripts/extract-specimens.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "predev": "node scripts/extract-specimens.mjs",
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p 3410",
    "prebuild": "node scripts/extract-specimens.mjs && node scripts/lint-copy.mjs --source-only",
    "build": "rm -rf out && next build && node scripts/lint-copy.mjs && rm -rf out/design out/poster",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axp/design-system": "workspace:*",
    "lenis": "^1.3.0",
    "motion": "^12.0.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
