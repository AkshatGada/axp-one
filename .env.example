# AXP configuration. Copy to .env.local (gitignored) and fill in only what you need.
# NEVER commit real values. Recorded replay and the static sites need NONE of these.
# Process environment variables override .env.local. Never put a key in NEXT_PUBLIC_*.

# --- Model providers (live runs only) ---------------------------------------------
# Jev decisions (TypeSafe, model jev-1.13.0). Docs and keys: https://docs.typesafe.ai
# TYPESAFE_API_KEY is the supported legacy alias.
JEV_API_KEY=
# DeepSeek organic answers; model pinned to deepseek-flash. Keys: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- Hosted live runs (packages/hosted; scripts/hosted/dev-server.mjs locally) -----
# 1 = accept new live runs (real model calls, real Devnet signing). Anything else = off.
AXP_LIVE_ENABLED=0
# Optional judge passcode required to start a run (empty = none).
AXP_LIVE_PASSCODE=
# Abuse caps (defaults shown).
AXP_LIVE_DAILY_CAP=20
AXP_LIVE_IP_DAILY_CAP=3
AXP_LIVE_MAX_ACTIVE=1
AXP_LIVE_DELIVERY_WINDOW_SECONDS=600
# Stable Devnet wallets (two advertiser payers + one publisher). Locally a 0600 file made by
#   node scripts/hosted/wallets.mjs init
# and funded once from your own Devnet wallet (see README). Devnet only; tokens have no value.
AXP_DEVNET_WALLETS_PATH=local-state/secrets/hosted-devnet-wallets.json
# Hosted: the same wallet file as one base64 string (a Vercel environment variable).
AXP_DEVNET_WALLETS=
# 32 random bytes, base64 (openssl rand -base64 32): encrypts private run state at rest.
# Required with a KV store; local development generates local-state/hosted/state.key.
AXP_STATE_KEY=
# Run store. Empty = a local directory (AXP_HOSTED_DATA_DIR). Hosted: Upstash Redis from the
# Vercel Marketplace, which injects these two (UPSTASH_REDIS_REST_URL/TOKEN also accepted).
KV_REST_API_URL=
KV_REST_API_TOKEN=
AXP_HOSTED_DATA_DIR=local-state/hosted
# Bearer secret for /api/cron/sweep (Vercel Cron sends it when the variable is set).
CRON_SECRET=
# Local dev server port and an optional merged single-site build directory.
AXP_HOSTED_PORT=3100
AXP_SITE_DIR=

# --- Operator tooling (recorded V3 console, payment SDK, terminal live operator) ---
AXP_TEST_WALLET_PATH=local-state/secrets/test-wallets.json
AXP_PAYMENT_SDK_ROOT=local-state/phase4-sdk
AXP_V3_PORT=8794
AXP_V3_ENABLE_MODELS=0
AXP_V3_OPERATOR_SIGN=0
