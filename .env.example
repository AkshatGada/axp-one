# AXP configuration. Copy to .env.local (gitignored) and fill in only what you need.
# NEVER commit real values. Recorded replay and the static sites need NONE of these.
# Process environment variables override .env.local. Never put a key in NEXT_PUBLIC_*.

# --- Model providers (live runs only) ---------------------------------------------
# Jev decisions (TypeSafe, model jev-1.13.0). Docs and keys: https://docs.typesafe.ai
# TYPESAFE_API_KEY is the supported legacy alias.
JEV_API_KEY=
# DeepSeek organic answers; model pinned to deepseek-flash. Keys: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- Additive user-operated product demo (npm run demo:product) ------------------
# Real model calls, synthetic test-credit accounting; separate from the old MVP.
AXP_PRODUCT_PORT=3430
AXP_PRODUCT_UI_PORT=3432
AXP_PRODUCT_STATE_DIR=local-state/product
AXP_PRODUCT_DEMO_MODE=0
# Opt-in only: devnet requires a separate state directory and server signing capability.
AXP_PRODUCT_FINANCIAL_MODE=synthetic
AXP_PRODUCT_DEVNET_SIGN=0
AXP_PRODUCT_JEV_DAILY_CAP=50
# Optional override; otherwise an ignored publisher API key is generated locally.
AXP_PUBLISHER_API_KEY=
# Server-held product wallet; only used when native Devnet mode/signing are explicitly enabled.
AXP_PRODUCT_DEVNET_WALLET_PATH=local-state/product/secrets/devnet-wallet.json

# --- Hosted user-operated product (Vercel server environment) -------------------
# These defaults keep hosting disabled in a fresh clone. See docs/product/HOSTING.md.
AXP_PRODUCT_ENABLED=0
AXP_PRODUCT_WORKSPACE_ID=demo
# Base64 JSON of the product wallet; never supply in browser code or commit real values.
AXP_PRODUCT_DEVNET_WALLET=
AXP_PRODUCT_PASSCODE=
# SDK clients connect to axp.one by default; the local developer example defaults to loopback.
# Set this explicitly to choose the intended exchange, with its matching publisher key:
# AXP_EXCHANGE_URL=https://axp.one/api/product

# --- Hosted live runs (packages/hosted; scripts/hosted/dev-server.mjs locally) -----
# 1 = accept new live runs (real model calls, real Devnet signing). Anything else = off.
AXP_LIVE_ENABLED=0
# Optional judge passcode required to start a run (empty = none).
AXP_LIVE_PASSCODE=
# Abuse caps (defaults shown).
AXP_LIVE_DAILY_CAP=20
AXP_LIVE_IP_DAILY_CAP=3
AXP_LIVE_MAX_ACTIVE=1
AXP_LIVE_DELIVERY_WINDOW_SECONDS=600
# A run with no progress for this many seconds stops counting as active (600-7200).
AXP_LIVE_STALE_SECONDS=3600
# Stable Devnet wallets (two advertiser payers + one publisher). Locally a 0600 file made by
#   node scripts/hosted/wallets.mjs init
# and funded once from your own Devnet wallet (see README). Devnet only; tokens have no value.
AXP_DEVNET_WALLETS_PATH=local-state/secrets/hosted-devnet-wallets.json
# Hosted: the same wallet file as one base64 string (a Vercel environment variable).
AXP_DEVNET_WALLETS=
# 32 random bytes, base64 (openssl rand -base64 32): encrypts private run state at rest.
# Required with a KV store; local development generates local-state/hosted/state.key.
AXP_STATE_KEY=
# Run store. Hosted: Vercel Blob (a PRIVATE store connected to the project; Vercel injects
# BLOB_READ_WRITE_TOKEN). Optional alternative: Upstash Redis (KV_REST_API_URL/TOKEN, or
# UPSTASH_REDIS_REST_*) with AXP_RUN_STORE=upstash. Locally, empty = a directory (AXP_HOSTED_DATA_DIR).
AXP_RUN_STORE=
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
AXP_HOSTED_DATA_DIR=local-state/hosted
# Bearer secret for /api/cron/sweep (Vercel Cron sends it when the variable is set).
CRON_SECRET=
# Local dev server port and an optional merged single-site build directory.
AXP_HOSTED_PORT=3100
AXP_SITE_DIR=

# --- Operator tooling (recorded V3 console, payment SDK, terminal live operator) ---
AXP_TEST_WALLET_PATH=local-state/secrets/test-wallets.json
AXP_PAYMENT_SDK_ROOT=local-state/phase4-sdk
# The next three are read from the process environment only (not from .env.local):
# replay/operator console port, actual Jev calls (1 = on), operator signing (1 = on).
AXP_V3_PORT=8794
AXP_V3_ENABLE_MODELS=0
AXP_V3_OPERATOR_SIGN=0

# --- Optional, process environment only (export or prefix the command; .env.local is NOT read) ---
# 1 = allow scripts/hosted/e2e-live.mjs to spend real model calls and Devnet test tokens.
# AXP_E2E_LIVE=
# Path to Chrome for the e2e run (default: /Applications/Google Chrome.app on macOS).
# AXP_CHROME_BIN=
# 1 = allow `scripts/hosted/wallets.mjs fund` to sign Devnet transfers from AXP_TEST_WALLET_PATH.
# AXP_HOSTED_DEVNET_SIGN=
# 1 = allow the terminal Devnet operator (scripts/demo/v3-devnet-live.mjs) to sign.
# AXP_V3_DEVNET_SIGN=
# Codex CLI binary for the terminal operator / DSP planner (default: codex, or the ChatGPT app's copy).
# AXP_CODEX_BIN=
# MVP build: which recorded run to render (default artifacts/v3-devnet-live-rehearsal/replay).
# AXP_RUN_DIR=
# MVP build: URL prefix when served under a path, e.g. /mvp (public; never a secret).
# NEXT_PUBLIC_BASE_PATH=
# Older baseline backend (npm start): port, state directory, run id, optional corpus ("ads" only).
# AXP_PORT=
# AXP_STATE_DIR=
# AXP_RUN_ID=
# AXP_CORPUS_DB=
